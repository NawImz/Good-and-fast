---
import { business } from "../data/business.mjs";

/*
 * Tant que le texte exact, les noms et les étoiles des avis n'ont pas été
 * fournis, `avisVerifies` reste faux : ces blocs sont des synthèses et non des
 * citations, aucun balisage schema.org Review n'est émis, et l'écran le dit.
 * Publier des avis reconstitués serait une pratique commerciale trompeuse
 * (art. L121-2 du code de la consommation).
 */
const { valeur, nombre, source } = business.note;
const pourcentage = (valeur / 5) * 100;
---

<section id="avis" class="border-y border-encre/10 bg-os-pur">
  <div class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-24" data-anim-groupe>
    <div class="md:flex md:items-end md:justify-between md:gap-12">
      <div class="max-w-xl">
        <h2 data-anim class="titre-section text-[0.72rem] text-rouge">Ce qu'en disent les clients</h2>
        <p data-anim class="mt-4 text-[2rem] leading-[1.03] font-bold tracking-[-0.015em] md:text-[2.6rem]">
          390 avis, et toujours les mêmes remarques.
        </p>
      </div>

      <div data-anim class="mt-7 shrink-0 md:mt-0">
        <p class="flex items-baseline gap-2">
          <span class="chiffres text-[3.2rem] leading-none font-bold">
            {valeur.toLocaleString("fr-FR")}
          </span>
          <span class="text-[1.1rem] text-gris">/ 5</span>
        </p>

        <div class="mt-2 flex items-center gap-2">
          <span
            class="relative inline-block leading-none"
            role="img"
            aria-label={`Note de ${valeur.toLocaleString("fr-FR")} sur 5`}
          >
            <span aria-hidden="true" class="text-[1.15rem] tracking-[0.12em] text-gris-clair">★★★★★</span>
            <span
              aria-hidden="true"
              class="absolute inset-0 overflow-hidden text-[1.15rem] tracking-[0.12em] whitespace-nowrap text-rouge"
              style={`width:${pourcentage}%`}
            >★★★★★</span>
          </span>
          <span class="chiffres text-[0.85rem] text-gris">{nombre} avis {source}</span>
        </div>
      </div>
    </div>

    <ul class="mt-11 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {business.themesAvis.map((t) => (
        <li data-anim class="border-t-2 border-rouge pt-4">
          <p class="text-[1.05rem] leading-snug font-bold">{t.titre}</p>
          <p class="mt-2 text-[0.92rem] leading-relaxed text-gris">{t.texte}</p>
        </li>
      ))}
    </ul>

    {!business.avisVerifies && (
      <p class="mt-10 max-w-2xl border-l-2 border-gris-clair pl-4 text-[0.85rem] leading-relaxed text-gris">
        Ces quatre blocs résument ce qui revient dans les avis publics. Ce ne
        sont pas des citations et ils ne sont attribués à personne : les avis
        exacts, avec leurs auteurs, remplaceront ces synthèses dès que le
        restaurant nous les aura transmis.
      </p>
    )}
  </div>
</section>
