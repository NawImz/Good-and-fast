---
import { business } from "../data/business.mjs";
import { prix } from "../lib/format.mjs";
---

<section id="carte" class="mx-auto max-w-6xl px-5 py-14 md:px-8 md:py-24">
  <div class="max-w-2xl" data-anim-groupe>
    <h2 data-anim class="titre-section text-[0.72rem] text-rouge">La carte</h2>
    <p data-anim class="mt-4 text-[2rem] leading-[1.03] font-bold tracking-[-0.015em] md:text-[2.6rem]">
      De 2,50 € à 9 €, tout est là.
    </p>
    <p data-anim class="mt-4 text-[1.02rem] leading-relaxed text-gris">
      Relevé sur les panneaux affichés en salle. Les menus comprennent les
      frites et la boisson. {business.accueil.consigne}
    </p>
  </div>

  <!-- Panneaux rectangulaires, pastille de catégorie sombre et prix en pastille
       rouge : c'est le système d'affichage réel du comptoir, transposé. -->
  <div class="mt-10 grid gap-5 md:mt-14 md:grid-cols-2 md:gap-6" data-anim-groupe>
    {business.carte.map((cat) => (
      <article data-anim class="flex flex-col border border-encre/10 bg-panneau p-5 md:p-7">
        <h3>
          <span class="inline-block rounded-full bg-encre px-4 py-1.5 text-[0.95rem] font-bold text-os">
            {cat.nom}
          </span>
        </h3>
        <p class="mt-4 text-[0.92rem] leading-snug text-gris">{cat.accroche}</p>

        <ul class="mt-5 divide-y divide-encre/10">
          {cat.items.map((it) => (
            <li class="flex items-baseline gap-x-4 py-2.5">
              {/* Nom et détail dans un même bloc : sinon un détail long pousse
                  le prix à la ligne suivante et la colonne se désaligne. */}
              <span class="min-w-0">
                <span class="font-bold">{it.nom}</span>
                {it.detail && <span class="ml-2 text-[0.85rem] text-gris">{it.detail}</span>}
              </span>
              <span class="ml-auto flex shrink-0 items-baseline gap-2">
                {it.prix != null && (
                  <span class="chiffres text-[0.95rem] font-bold text-rouge">
                    {it.prefixe ?? ""}{prix(it.prix)}
                  </span>
                )}
                {it.prixMenu != null && (
                  <span class="chiffres rounded-full bg-rouge px-2.5 py-1 text-[0.8rem] font-bold text-os">
                    Menu {prix(it.prixMenu)}
                  </span>
                )}
                {it.prix == null && it.prixMenu == null && (
                  <span class="text-[0.8rem] text-gris">prix en boutique</span>
                )}
              </span>
            </li>
          ))}
        </ul>

        {cat.choix && (
          <div class="mt-5 space-y-3">
            {cat.choix.map((c) => (
              <div>
                <p class="titre-section text-[0.65rem] text-gris">{c.titre}</p>
                <p class="mt-1.5 text-[0.9rem] leading-snug">{c.valeurs.join(" · ")}</p>
              </div>
            ))}
          </div>
        )}

        {cat.supplements && (
          <ul class="mt-5 space-y-1.5 border-t border-encre/10 pt-4 text-[0.85rem] text-gris">
            {cat.supplements.map((s) => (
              <li class="flex gap-3">
                <span>{s.nom}</span>
                <span class="chiffres ml-auto shrink-0 font-bold text-encre">+ {prix(s.prix)}</span>
              </li>
            ))}
          </ul>
        )}

        {cat.note && <p class="mt-5 text-[0.85rem] leading-snug text-gris">{cat.note}</p>}
      </article>
    ))}
  </div>

  <p class="mt-7 text-[0.85rem] text-gris">
    Prix relevés sur les panneaux affichés en salle. Seuls les prix affichés en
    boutique au moment de la commande font foi.
  </p>
</section>
