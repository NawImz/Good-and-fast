---
import { business, telHref } from "../data/business.mjs";

const liens = [
  { href: "#signature", texte: "La spécialité" },
  { href: "#carte", texte: "La carte" },
  { href: "#avis", texte: "Les avis" },
  { href: "#infos", texte: "Horaires & accès" },
];
---

<!-- L'en-tête est un panneau posé sur le mur, pas une barre pleine largeur :
     le mur reste visible de chaque côté, comme le reste de la page. -->
<div class="sticky top-0 z-40 px-4 pt-3 pb-2 md:px-6 md:pt-4">
  <header
    data-entete
    class="panneau mx-auto flex max-w-6xl items-center gap-3 px-4 py-2.5 md:px-6"
  >
    <a
      href="#contenu"
      class="enseigne flex min-h-11 items-center text-[1rem] leading-none text-rouge md:text-[1.15rem]"
    >
      Good&#8202;<span class="text-encre">&amp;</span>&#8202;Fast
    </a>

    <nav aria-label="Sections du site" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {liens.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex min-h-11 items-center rounded-pastille px-3.5 text-[0.9rem] text-gris transition-colors duration-150 hover:bg-brique hover:text-encre"
            >
              {l.texte}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Le CTA d'en-tête est réservé au desktop : sur mobile il ferait doublon
         avec la barre d'appel fixe en bas, à portée de pouce. -->
    <a
      href={telHref}
      class="ml-auto hidden min-h-11 items-center rounded-pastille bg-rouge px-5 font-titre text-[0.9rem] font-bold text-os transition-transform duration-150 hover:-translate-y-px md:ml-0 md:inline-flex"
    >
      {business.telephone.affichage}
    </a>

    <button
      type="button"
      data-menu-bascule
      aria-expanded="false"
      aria-controls="menu-mobile"
      class="ml-auto grid h-11 w-11 place-items-center rounded-pastille bg-brique md:hidden"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <span aria-hidden="true" class="relative block h-3 w-5">
        <span class="absolute inset-x-0 top-0 h-0.5 rounded-pastille bg-encre"></span>
        <span class="absolute inset-x-0 top-1.5 h-0.5 rounded-pastille bg-encre"></span>
        <span class="absolute inset-x-0 top-3 h-0.5 rounded-pastille bg-encre"></span>
      </span>
    </button>
  </header>

  <div
    id="menu-mobile"
    data-menu-panneau
    hidden
    class="panneau mx-auto mt-2 max-w-6xl px-3 py-2 md:hidden"
  >
    <ul>
      {liens.map((l) => (
        <li>
          <a
            href={l.href}
            class="flex min-h-12 items-center rounded-chip px-3 text-[0.95rem] transition-colors duration-150 hover:bg-brique"
          >
            {l.texte}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
