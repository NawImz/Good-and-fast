---
import { business, telHref } from "../data/business.mjs";

const liens = [
  { href: "#signature", texte: "La spécialité" },
  { href: "#carte", texte: "La carte" },
  { href: "#avis", texte: "Les avis" },
  { href: "#infos", texte: "Horaires & accès" },
];
---

<header
  data-entete
  class="sticky top-0 z-40 border-b border-encre/10 bg-os/95 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-6xl items-center gap-4 px-5 py-3 md:px-8">
    <a href="#contenu" class="enseigne flex min-h-11 items-center text-[1.05rem] leading-none text-rouge md:text-xl">
      Good&#8202;<span class="text-encre">&amp;</span>&#8202;Fast
    </a>

    <nav aria-label="Sections du site" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-7 text-[0.9rem]">
        {liens.map((l) => (
          <li>
            <a href={l.href} class="flex min-h-11 items-center text-gris transition-colors duration-150 hover:text-encre">
              {l.texte}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Le CTA d'en-tête est réservé au desktop : sur mobile il ferait doublon
         avec la barre d'appel fixe en bas, à portée de pouce. -->
    <a
      href={telHref}
      class="ml-auto hidden min-h-11 items-center gap-2 bg-rouge px-4 text-[0.9rem] font-bold text-os transition-transform duration-150 hover:-translate-y-px md:ml-0 md:inline-flex"
    >
      {business.telephone.affichage}
    </a>

    <button
      type="button"
      data-menu-bascule
      aria-expanded="false"
      aria-controls="menu-mobile"
      class="ml-auto grid h-11 w-11 place-items-center md:hidden"
    >
      <span class="sr-only">Ouvrir le menu</span>
      <span aria-hidden="true" class="relative block h-3.5 w-6">
        <span class="absolute inset-x-0 top-0 h-0.5 bg-encre"></span>
        <span class="absolute inset-x-0 top-1.5 h-0.5 bg-encre"></span>
        <span class="absolute inset-x-0 top-3 h-0.5 bg-encre"></span>
      </span>
    </button>
  </div>

  <div id="menu-mobile" data-menu-panneau hidden class="border-t border-encre/10 md:hidden">
    <ul class="px-5 py-2">
      {liens.map((l) => (
        <li>
          <a href={l.href} class="flex min-h-12 items-center border-b border-encre/5 text-[0.95rem]">
            {l.texte}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>
