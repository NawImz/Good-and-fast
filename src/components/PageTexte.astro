---
import Entete from "./Entete.astro";
import PiedDePage from "./PiedDePage.astro";
import BarreAppel from "./BarreAppel.astro";

interface Props { titre: string }
const { titre } = Astro.props;
---

<Entete />
<main id="contenu" class="mx-auto max-w-2xl px-5 py-12 md:px-8 md:py-20">
  <h1 class="text-[2.1rem] leading-[1.05] font-bold tracking-[-0.015em] md:text-[2.8rem]">
    {titre}
  </h1>
  <span class="bandeau mt-6 w-24" aria-hidden="true"></span>
  <div class="mt-8 space-y-8 text-[1rem] leading-relaxed text-gris">
    <slot />
  </div>
  <p class="mt-12">
    <a href="/" class="inline-flex min-h-11 items-center font-bold text-rouge underline underline-offset-4">Retour à l'accueil</a>
  </p>
</main>
<PiedDePage />
<BarreAppel />
