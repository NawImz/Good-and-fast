---
import { Image } from "astro:assets";
import { business, telHref, itineraireHref } from "../data/business.mjs";
import { photos } from "../data/photos.mjs";
---

<!--
  Le premier écran est une assiette.

  La photo est cadrée en cercle et déborde du panneau : dans ce commerce, tout
  ce qui se vend est rond — le naan, la pizza, l'assiette, la tortilla. Le
  cercle n'est pas un effet de style, c'est la forme du produit, et il évite le
  hero coupé en deux qu'on retrouve sur n'importe quel site.
-->
<section id="contenu" class="panneau panneau-lg relative overflow-hidden px-5 pt-8 pb-9 md:px-12 md:py-14">
  <div class="md:flex md:items-center md:gap-12 lg:gap-16" data-anim-groupe>
    <div data-hero-image class="mx-auto w-[86%] max-w-[22rem] shrink-0 md:mx-0 md:w-[38%] md:max-w-none">
      <Image
        src={photos.grecFrites.src}
        alt={photos.grecFrites.alt}
        widths={[360, 720, 1080]}
        sizes="(min-width: 48rem) 38vw, 86vw"
        format="webp"
        quality={74}
        loading="eager"
        fetchpriority="high"
        class="aspect-square w-full rounded-pastille object-cover object-[46%_58%]"
      />
    </div>

    <div class="mt-7 md:mt-0">
      <h1 data-anim class="titre text-[2.5rem] md:text-[3.2rem] lg:text-[3.7rem]">
        Coupé minute.<br />
        <span class="text-rouge">Servi en trois minutes.</span>
      </h1>

      <p data-anim class="mt-5 max-w-md text-[1.05rem] leading-relaxed text-gris">
        Grec tranché à la broche quand vous commandez, pain naan pétri du jour,
        frites qui sortent du bain.
      </p>

      <div data-anim class="mt-6 flex flex-wrap items-center gap-2.5">
        <span class="etiquette bg-brique text-encre">
          <span class="chiffres">{business.note.valeur.toLocaleString("fr-FR")}/5</span>
          <span class="text-gris">· {business.note.nombre} avis {business.note.source}</span>
        </span>
        <!-- Seul emploi du script de la vitrine dans toute la page. -->
        <span class="script text-[1.35rem] leading-none text-rouge">Viande halal</span>
      </div>

      <div data-anim class="mt-7 flex flex-wrap gap-3">
        <a
          href={telHref}
          class="inline-flex min-h-[3.25rem] items-center rounded-pastille bg-rouge px-7 font-titre text-[1.05rem] font-bold text-os transition-transform duration-150 hover:-translate-y-0.5"
        >
          Appeler {business.telephone.affichage}
        </a>
        <a
          href={itineraireHref}
          class="inline-flex min-h-[3.25rem] items-center rounded-pastille border-2 border-encre px-7 font-titre text-[1.05rem] font-bold text-encre transition-colors duration-150 hover:bg-encre hover:text-os"
        >
          Itinéraire
        </a>
      </div>
    </div>
  </div>
</section>
