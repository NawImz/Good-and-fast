---
import Base from "../layouts/Base.astro";
import PageTexte from "../components/PageTexte.astro";
import ChampLegal from "../components/ChampLegal.astro";
import { business, adresseLigne } from "../data/business.mjs";

const l = business.legal;
const incomplet = [l.formeJuridique, l.siret, l.directeurPublication, l.hebergeur.nom].some((v) => v == null);
---

<Base
  titre="Mentions légales — Good & Fast"
  description="Mentions légales du site de Good & Fast, fast food halal au 62 avenue de la République à Épinay-sur-Seine."
  chemin="/mentions-legales"
>
  <PageTexte titre="Mentions légales">
    {incomplet && (
      <p class="border-l-2 border-rouge bg-rouge/5 py-4 pl-4 text-[0.95rem] text-encre">
        <strong>Ces mentions sont incomplètes.</strong> L'article 6-III de la
        loi n° 2004-575 du 21 juin 2004 impose d'identifier l'éditeur et
        l'hébergeur du site. Les champs signalés ci-dessous doivent être
        renseignés avant toute mise en ligne publique : leur absence est une
        infraction dès le premier jour de publication.
      </p>
    )}

    <section>
      <h2 class="text-[1.15rem] font-bold text-encre">Éditeur du site</h2>
      <dl class="mt-4">
        <ChampLegal libelle="Raison sociale" valeur={business.raisonSociale} />
        <ChampLegal libelle="Forme juridique" valeur={l.formeJuridique} />
        <ChampLegal libelle="Adresse" valeur={adresseLigne} />
        <ChampLegal libelle="Téléphone" valeur={business.telephone.affichage} />
        <ChampLegal libelle="SIRET" valeur={l.siret} />
        <ChampLegal libelle="Numéro de TVA intracommunautaire" valeur={l.tva} />
        <ChampLegal libelle="Capital social" valeur={l.capital} />
        <ChampLegal libelle="Directeur de la publication" valeur={l.directeurPublication} />
      </dl>
    </section>

    <section>
      <h2 class="text-[1.15rem] font-bold text-encre">Hébergeur</h2>
      <dl class="mt-4">
        <ChampLegal libelle="Raison sociale" valeur={l.hebergeur.nom} />
        <ChampLegal libelle="Adresse" valeur={l.hebergeur.adresse} />
      </dl>
    </section>

    <section>
      <h2 class="text-[1.15rem] font-bold text-encre">Conception du site</h2>
      <dl class="mt-4">
        <ChampLegal libelle="Réalisation" valeur={l.editeurSite} />
      </dl>
    </section>

    <section>
      <h2 class="text-[1.15rem] font-bold text-encre">Propriété intellectuelle</h2>
      <p class="mt-3">
        Les photographies du restaurant, de la devanture et des plats ont été
        fournies par {business.raisonSociale}. Les textes et la mise en page de
        ce site ne peuvent être reproduits sans autorisation.
      </p>
    </section>

    <section>
      <h2 class="text-[1.15rem] font-bold text-encre">Prix et disponibilité</h2>
      <p class="mt-3">
        Les prix affichés sur ce site sont relevés sur les panneaux en salle et
        donnés à titre indicatif. Seuls les prix affichés en boutique au moment
        de la commande font foi. Certaines lignes de la carte peuvent être
        indisponibles selon l'heure et le service.
      </p>
    </section>
  </PageTexte>
</Base>
