---
import Base from "../layouts/Base.astro";
import Entete from "../components/Entete.astro";
import Hero from "../components/Hero.astro";
import Signature from "../components/Signature.astro";
import Presentation from "../components/Presentation.astro";
import Carte from "../components/Carte.astro";
import Avis from "../components/Avis.astro";
import Infos from "../components/Infos.astro";
import PiedDePage from "../components/PiedDePage.astro";
import BarreAppel from "../components/BarreAppel.astro";
---

<Base
  titre="Good & Fast — fast food halal à Épinay-sur-Seine"
  description="Kebab, tacos, cheese naan et pizzas halal à Épinay-sur-Seine (93800). Viande coupée à la commande, de 2,50 € à 9 €, ouvert jusqu'à minuit."
>
  <Entete />
  <!-- Les sections sont des panneaux posés sur le mur, avec du mur entre eux :
       le contraire des bandes pleine largeur collées les unes aux autres. -->
  <main class="mx-auto flex max-w-6xl flex-col gap-3.5 px-4 pb-6 md:gap-5 md:px-6 md:pb-10">
    <Hero />
    <Signature />
    <Presentation />
    <Carte />
    <Avis />
    <Infos />
    <PiedDePage />
  </main>
  <BarreAppel />
</Base>
